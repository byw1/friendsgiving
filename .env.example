# Postgres connection string. On Railway, reference the Postgres service: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fg

# Optional: your site's public URL, used for link previews (iMessage, Slack, etc).
# On Railway you can skip this; it falls back to the Railway domain.
APP_URL=http://localhost:3000

# Optional: where guests RSVP (Partiful, Luma, Evite, a Google Form...).
# Leave empty to hide the RSVP buttons.
RSVP_URL=
